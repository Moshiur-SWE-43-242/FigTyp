# Server
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# JWT signing secret — use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Gmail account used to send OTP emails (use an App Password, not the real password)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-gmail-app-password

# Comma-separated list of emails that get the SUPER_ADMIN role on registration
SUPER_ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Allowed origin for socket.io CORS (your deployed frontend URL); defaults to * if unset
FRONTEND_URL=
